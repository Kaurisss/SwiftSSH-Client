    "The connection was not saved and its previous password could not be restored. Enter the password again and retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was not saved and its previous password could not be restored. Enter the password again and retry."
